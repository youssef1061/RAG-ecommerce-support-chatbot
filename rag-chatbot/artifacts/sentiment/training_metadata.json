{
  "base_model": "distilbert-base-uncased",
  "dataset": "dair-ai/emotion",
  "mapping": {
    "negative": [
      "sadness",
      "anger",
      "fear"
    ],
    "neutral": [
      "surprise"
    ],
    "positive": [
      "joy",
      "love"
    ]
